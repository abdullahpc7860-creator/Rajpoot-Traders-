<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rajpoot Traders - Tori Sale & Ledger Management</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: 'var(--color-brand-50)',
                            100: 'var(--color-brand-100)',
                            200: 'var(--color-brand-200)',
                            500: 'var(--color-brand-500)',
                            600: 'var(--color-brand-600)',
                            700: 'var(--color-brand-700)',
                            800: 'var(--color-brand-800)',
                            900: 'var(--color-brand-900)',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            /* Default Theme: Emerald Trader */
            --bg-main: #f8fafc;
            --bg-card: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --color-brand-50: #ecfdf5;
            --color-brand-100: #d1fae5;
            --color-brand-200: #a7f3d0;
            --color-brand-500: #10b981;
            --color-brand-600: #059669;
            --color-brand-700: #047857;
            --color-brand-800: #065f46;
            --color-brand-900: #064e3b;
        }

        /* 12 Theme Templates */
        [data-theme="emerald"] {
            --bg-main: #f8fafc; --bg-card: #ffffff; --text-main: #0f172a; --text-muted: #64748b; --border-color: #e2e8f0;
            --color-brand-50: #ecfdf5; --color-brand-100: #d1fae5; --color-brand-200: #a7f3d0; --color-brand-500: #10b981;
            --color-brand-600: #059669; --color-brand-700: #047857; --color-brand-800: #065f46; --color-brand-900: #064e3b;
        }
        [data-theme="midnight-dark"] {
            --bg-main: #0f172a; --bg-card: #1e293b; --text-main: #f8fafc; --text-muted: #94a3b8; --border-color: #334155;
            --color-brand-50: #1e293b; --color-brand-100: #334155; --color-brand-200: #475569; --color-brand-500: #3b82f6;
            --color-brand-600: #2563eb; --color-brand-700: #1d4ed8; --color-brand-800: #1e40af; --color-brand-900: #1e3a8a;
        }
        [data-theme="ocean-blue"] {
            --bg-main: #f0f9ff; --bg-card: #ffffff; --text-main: #0c4a6e; --text-muted: #0369a1; --border-color: #bae6fd;
            --color-brand-50: #f0f9ff; --color-brand-100: #e0f2fe; --color-brand-200: #bae6fd; --color-brand-500: #0284c7;
            --color-brand-600: #0369a1; --color-brand-700: #075985; --color-brand-800: #0c4a6e; --color-brand-900: #0a3650;
        }
        [data-theme="royal-purple"] {
            --bg-main: #faf5ff; --bg-card: #ffffff; --text-main: #3b0764; --text-muted: #7e22ce; --border-color: #e9d5ff;
            --color-brand-50: #faf5ff; --color-brand-100: #f3e8ff; --color-brand-200: #e9d5ff; --color-brand-500: #a855f7;
            --color-brand-600: #9333ea; --color-brand-700: #7e22ce; --color-brand-800: #6b21a8; --color-brand-900: #581c87;
        }
        [data-theme="crimson-red"] {
            --bg-main: #fff5f5; --bg-card: #ffffff; --text-main: #450a0a; --text-muted: #b91c1c; --border-color: #fecaca;
            --color-brand-50: #fef2f2; --color-brand-100: #fee2e2; --color-brand-200: #fecaca; --color-brand-500: #ef4444;
            --color-brand-600: #dc2626; --color-brand-700: #b91c1c; --color-brand-800: #991b1b; --color-brand-900: #7f1d1d;
        }
        [data-theme="amber-gold"] {
            --bg-main: #fffbeb; --bg-card: #ffffff; --text-main: #451a03; --text-muted: #b45309; --border-color: #fde68a;
            --color-brand-50: #fffbeb; --color-brand-100: #fef3c7; --color-brand-200: #fde68a; --color-brand-500: #f59e0b;
            --color-brand-600: #d97706; --color-brand-700: #b45309; --color-brand-800: #92400e; --color-brand-900: #78350f;
        }
        [data-theme="slate-corporate"] {
            --bg-main: #f1f5f9; --bg-card: #ffffff; --text-main: #0f172a; --text-muted: #475569; --border-color: #cbd5e1;
            --color-brand-50: #f8fafc; --color-brand-100: #f1f5f9; --color-brand-200: #e2e8f0; --color-brand-500: #64748b;
            --color-brand-600: #475569; --color-brand-700: #334155; --color-brand-800: #1e293b; --color-brand-900: #0f172a;
        }
        [data-theme="forest-green"] {
            --bg-main: #f4fbf7; --bg-card: #ffffff; --text-main: #062c19; --text-muted: #15803d; --border-color: #bbf7d0;
            --color-brand-50: #f0fdf4; --color-brand-100: #dcfce7; --color-brand-200: #bbf7d0; --color-brand-500: #22c55e;
            --color-brand-600: #16a34a; --color-brand-700: #15803d; --color-brand-800: #166534; --color-brand-900: #14532d;
        }
        [data-theme="cyberpunk-dark"] {
            --bg-main: #050505; --bg-card: #121212; --text-main: #00ffcc; --text-muted: #ff007f; --border-color: #2a2a2a;
            --color-brand-50: #1a1a1a; --color-brand-100: #2a2a2a; --color-brand-200: #ff007f; --color-brand-500: #00ffcc;
            --color-brand-600: #00e6b8; --color-brand-700: #00b38f; --color-brand-800: #008066; --color-brand-900: #004d3d;
        }
        [data-theme="sunset-orange"] {
            --bg-main: #fff7ed; --bg-card: #ffffff; --text-main: #431407; --text-muted: #c2410c; --border-color: #ffedd5;
            --color-brand-50: #fff7ed; --color-brand-100: #ffedd5; --color-brand-200: #fed7aa; --color-brand-500: #f97316;
            --color-brand-600: #ea580c; --color-brand-700: #c2410c; --color-brand-800: #9a3412; --color-brand-900: #7c2d12;
        }
        [data-theme="coffee-warm"] {
            --bg-main: #fdfbf7; --bg-card: #ffffff; --text-main: #271c19; --text-muted: #78350f; --border-color: #e7e5e4;
            --color-brand-50: #fafaf9; --color-brand-100: #f5f5f4; --color-brand-200: #e7e5e4; --color-brand-500: #a8a29e;
            --color-brand-600: #78716c; --color-brand-700: #57534e; --color-brand-800: #44403c; --color-brand-900: #292524;
        }
        [data-theme="nordic-frost"] {
            --bg-main: #f3f4f6; --bg-card: #ffffff; --text-main: #1f2937; --text-muted: #4b5563; --border-color: #e5e7eb;
            --color-brand-50: #f9fafb; --color-brand-100: #f3f4f6; --color-brand-200: #e5e7eb; --color-brand-500: #6b7280;
            --color-brand-600: #4b5563; --color-brand-700: #374151; --color-brand-800: #1f2937; --color-brand-900: #111827;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .bg-card { background-color: var(--bg-card); }
        .border-custom { border-color: var(--border-color); }
        .text-muted-custom { color: var(--text-muted); }

        @media print {
            body * { visibility: hidden; }
            #printable-ledger, #printable-ledger * { visibility: visible; }
            #printable-ledger { position: absolute; left: 0; top: 0; width: 100%; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="font-sans min-h-screen flex flex-col">

    <!-- Header Navigation -->
    <header class="bg-brand-800 text-white shadow-lg no-print transition-colors">
        <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6 lg:px-8 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-brand-700 rounded-lg">
                    <i data-lucide="package" class="w-7 h-7 text-brand-200"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold tracking-tight">Rajpoot Traders</h1>
                    <p class="text-xs text-brand-200">Tori Wholesaler & Ledger Portal</p>
                </div>
            </div>

            <!-- Theme Selector and Quick Stats -->
            <div class="flex flex-wrap items-center gap-4">
                <!-- Theme Dropdown -->
                <div class="flex items-center gap-2 bg-brand-900/60 px-3 py-1.5 rounded-full border border-brand-700/50 shadow-inner">
                    <i data-lucide="palette" class="w-4 h-4 text-brand-200"></i>
                    <select id="theme-select" onchange="changeTheme(this.value)" class="bg-transparent text-xs text-white font-medium focus:outline-none cursor-pointer">
                        <option value="emerald" class="text-slate-900">🟢 Emerald Trader</option>
                        <option value="midnight-dark" class="text-slate-900">🌙 Midnight Dark</option>
                        <option value="ocean-blue" class="text-slate-900">🌊 Ocean Blue</option>
                        <option value="royal-purple" class="text-slate-900">👑 Royal Purple</option>
                        <option value="crimson-red" class="text-slate-900">🔴 Crimson Red</option>
                        <option value="amber-gold" class="text-slate-900">🪙 Amber Gold</option>
                        <option value="slate-corporate" class="text-slate-900">🏢 Slate Corporate</option>
                        <option value="forest-green" class="text-slate-900">🌲 Forest Green</option>
                        <option value="cyberpunk-dark" class="text-slate-900">⚡ Cyberpunk Dark</option>
                        <option value="sunset-orange" class="text-slate-900">🌅 Sunset Orange</option>
                        <option value="coffee-warm" class="text-slate-900">☕ Warm Coffee</option>
                        <option value="nordic-frost" class="text-slate-900">❄️ Nordic Frost</option>
                    </select>
                </div>

                <!-- Daily Rate Quick Display -->
                <div class="flex items-center gap-4 bg-brand-900/60 px-4 py-1.5 rounded-full text-sm border border-brand-700/50">
                    <div>
                        <span class="block text-[10px] text-brand-200 uppercase font-semibold">Today's Rate (40kg)</span>
                        <span id="nav-daily-rate" class="font-bold text-base text-amber-300">Rs. 0</span>
                    </div>
                    <div class="h-6 w-px bg-brand-700"></div>
                    <div>
                        <span class="block text-[10px] text-brand-200 uppercase font-semibold">Rate / Kg</span>
                        <span id="nav-kg-rate" class="font-bold text-xs text-brand-100">Rs. 0.00</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8 flex-1 w-full grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Left Column: Daily Rate & Customer Management -->
        <div class="lg:col-span-4 space-y-6 no-print">
            
            <!-- Daily Rate Card -->
            <div class="bg-card rounded-2xl shadow-sm border border-custom p-5">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="font-bold text-sm flex items-center gap-2">
                        <i data-lucide="trending-up" class="w-4 h-4 text-brand-600"></i>
                        Set Daily Tori Rate
                    </h2>
                    <span class="text-[11px] px-2.5 py-0.5 bg-brand-50 text-brand-700 rounded-full font-medium border border-brand-200">40 kg Standard</span>
                </div>
                <form id="rate-form" onsubmit="updateDailyRate(event)" class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-muted-custom mb-1">Rate for 40 Kg (PKR)</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 text-sm font-semibold">Rs.</span>
                            <input type="number" id="daily-rate-input" step="0.01" min="0" placeholder="e.g. 1250" required
                                class="w-full pl-11 pr-4 py-2 bg-slate-50 text-slate-900 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-500 font-semibold text-sm">
                        </div>
                    </div>
                    <div class="bg-brand-50 p-2.5 rounded-xl flex justify-between items-center text-xs text-brand-900 border border-brand-100">
                        <span>Rate per 1 Kg:</span>
                        <span id="calculated-per-kg" class="font-bold">Rs. 0.00 / kg</span>
                    </div>
                    <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 bg-brand-100 hover:bg-brand-200 text-brand-800 font-semibold text-xs rounded-full border border-brand-300 transition-all shadow-sm active:scale-95">
                        <i data-lucide="check-circle" class="w-4 h-4"></i> Save Today's Rate
                    </button>
                </form>
            </div>

            <!-- Add New Customer Card -->
            <div class="bg-card rounded-2xl shadow-sm border border-custom p-5">
                <h2 class="font-bold text-sm mb-3 flex items-center gap-2">
                    <i data-lucide="user-plus" class="w-4 h-4 text-brand-600"></i>
                    Add New Customer
                </h2>
                <form id="customer-form" onsubmit="addCustomer(event)" class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-muted-custom mb-1">Customer Full Name</label>
                        <input type="text" id="cust-name" placeholder="e.g. Chaudhary Zubair" required
                            class="w-full px-3 py-2 bg-slate-50 text-slate-900 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-500 text-xs">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-xs font-semibold text-muted-custom mb-1">Phone Number</label>
                            <input type="tel" id="cust-phone" placeholder="0300-xxxxxxx"
                                class="w-full px-3 py-2 bg-slate-50 text-slate-900 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-500 text-xs">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-muted-custom mb-1">City/Location</label>
                            <input type="text" id="cust-city" placeholder="e.g. Faisalabad"
                                class="w-full px-3 py-2 bg-slate-50 text-slate-900 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-500 text-xs">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-amber-700 mb-1 flex items-center gap-1">
                            <i data-lucide="history" class="w-3.5 h-3.5"></i> Previous Unpaid Balance / Arrears (PKR)
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-amber-600 text-xs font-semibold">Rs.</span>
                            <input type="number" id="cust-prev-balance" step="0.01" min="0" placeholder="0 if new customer"
                                class="w-full pl-9 pr-3 py-2 bg-amber-50/50 text-slate-900 border border-amber-200 rounded-xl focus:ring-2 focus:ring-amber-500 text-xs font-semibold">
                        </div>
                        <p class="text-[10px] text-muted-custom mt-1">Carried-over ledger debt prior to setup date.</p>
                    </div>
                    <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs rounded-full border border-slate-300 transition-all shadow-sm active:scale-95">
                        <i data-lucide="plus" class="w-4 h-4"></i> Add Customer Profile
                    </button>
                </form>
            </div>

            <!-- Customer Directory Card -->
            <div class="bg-card rounded-2xl shadow-sm border border-custom p-5 flex flex-col h-[380px]">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="font-bold text-sm flex items-center gap-2">
                        <i data-lucide="users" class="w-4 h-4 text-brand-600"></i>
                        Customer Directory
                    </h2>
                    <span id="customer-count" class="text-xs bg-brand-50 text-brand-700 px-2 py-0.5 rounded-full font-bold border border-brand-200">0</span>
                </div>
                
                <div class="relative mb-3">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3 top-2.5 text-slate-400"></i>
                    <input type="text" id="search-customer" oninput="renderCustomerList()" placeholder="Search name or phone..."
                        class="w-full pl-9 pr-3 py-1.5 bg-slate-50 text-slate-900 border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-brand-500">
                </div>

                <div id="customer-list" class="flex-1 overflow-y-auto space-y-2 pr-1">
                    <!-- Dynamic List -->
                </div>
            </div>

        </div>

        <!-- Right Column: Portal & Ledger -->
        <div class="lg:col-span-8 space-y-6">

            <div id="active-portal" class="hidden space-y-6">
                
                <!-- Customer Header -->
                <div class="bg-card rounded-2xl shadow-sm border border-custom p-6 relative overflow-hidden">
                    <div class="flex flex-wrap justify-between items-start gap-4">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="bg-brand-100 text-brand-800 text-xs font-bold px-3 py-1 rounded-full border border-brand-300">ACTIVE CUSTOMER</span>
                                <span id="portal-cust-id" class="text-xs text-muted-custom"></span>
                            </div>
                            <h2 id="portal-cust-name" class="text-2xl font-black mt-1">---</h2>
                            <p id="portal-cust-info" class="text-xs text-muted-custom mt-1 flex items-center gap-3">
                                <span><i data-lucide="phone" class="w-3 h-3 inline mr-1"></i><span id="portal-cust-phone">---</span></span>
                                <span><i data-lucide="map-pin" class="w-3 h-3 inline mr-1"></i><span id="portal-cust-city">---</span></span>
                            </p>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-semibold text-muted-custom uppercase tracking-wide">Outstanding Balance</span>
                            <div id="portal-cust-balance" class="text-3xl font-black text-rose-600 mt-0.5">Rs. 0</div>
                        </div>
                    </div>

                    <!-- Action Bar with Interactive Badges -->
                    <div class="mt-6 pt-4 border-t border-custom flex flex-wrap gap-2 justify-between items-center no-print">
                        <div class="flex flex-wrap gap-2">
                            <button onclick="openSaleModal()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 hover:bg-emerald-200 border border-emerald-300 transition-all shadow-sm active:scale-95">
                                <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i> Record Sale
                            </button>
                            <button onclick="openPaymentModal()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-sky-100 text-sky-800 hover:bg-sky-200 border border-sky-300 transition-all shadow-sm active:scale-95">
                                <i data-lucide="hand-coins" class="w-3.5 h-3.5"></i> Record Payment
                            </button>
                            <button onclick="openPrevPaymentModal()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 hover:bg-amber-200 border border-amber-300 transition-all shadow-sm active:scale-95">
                                <i data-lucide="history" class="w-3.5 h-3.5"></i> Add Arrears
                            </button>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <button onclick="window.print()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200 border border-slate-300 transition-all shadow-sm active:scale-95">
                                <i data-lucide="printer" class="w-3.5 h-3.5"></i> Print Statement
                            </button>
                            <button onclick="deleteCustomer()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 hover:bg-rose-200 border border-rose-300 transition-all shadow-sm active:scale-95">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Printable Ledger -->
                <div id="printable-ledger" class="bg-card rounded-2xl shadow-sm border border-custom p-6 space-y-4">
                    
                    <div class="hidden print:block mb-6 border-b pb-4">
                        <div class="flex justify-between items-center">
                            <div>
                                <h1 class="text-2xl font-bold text-slate-900">Rajpoot Traders</h1>
                                <p class="text-sm text-slate-600">Tori Wholesalers & Commission Agents</p>
                            </div>
                            <div class="text-right">
                                <h2 class="text-xl font-bold text-slate-800">Customer Account Statement</h2>
                                <p class="text-xs text-slate-500">Printed: <span id="print-date"></span></p>
                            </div>
                        </div>
                        <div class="mt-4 p-3 bg-slate-50 rounded-lg flex justify-between text-sm text-slate-800">
                            <div><strong>Customer:</strong> <span id="print-cust-name"></span> (<span id="print-cust-phone"></span>)</div>
                            <div><strong>Outstanding Balance:</strong> <span id="print-cust-balance" class="font-bold text-rose-600"></span></div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between no-print">
                        <h3 class="font-bold text-base flex items-center gap-2">
                            <i data-lucide="file-text" class="w-4 h-4 text-brand-600"></i>
                            Transaction History
                        </h3>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead>
                                <tr class="bg-slate-100/50 border-y border-custom text-muted-custom uppercase font-semibold">
                                    <th class="py-2.5 px-3">Date</th>
                                    <th class="py-2.5 px-3">Description</th>
                                    <th class="py-2.5 px-3 text-center">Bundles</th>
                                    <th class="py-2.5 px-3 text-right">Weight (Kg)</th>
                                    <th class="py-2.5 px-3 text-right">Rate / 40kg</th>
                                    <th class="py-2.5 px-3 text-right">Debit (+)</th>
                                    <th class="py-2.5 px-3 text-right">Credit (-)</th>
                                    <th class="py-2.5 px-3 text-right">Balance</th>
                                    <th class="py-2.5 px-3 text-center no-print">Action</th>
                                </tr>
                            </thead>
                            <tbody id="ledger-body" class="divide-y divide-slate-100">
                                <!-- Dynamic Ledger Rows -->
                            </tbody>
                        </table>
                    </div>

                    <div id="empty-ledger-msg" class="hidden text-center py-12 text-muted-custom">
