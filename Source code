    <!-- Script Application Logic -->
    <script>
        let appState = {
            theme: 'emerald',
            dailyRate40kg: 1250,
            customers: [],
            activeCustomerId: null
        };

        window.addEventListener('DOMContentLoaded', () => {
            loadState();
            lucide.createIcons();
            
            document.getElementById('daily-rate-input').addEventListener('input', (e) => {
                const val = parseFloat(e.target.value) || 0;
                document.getElementById('calculated-per-kg').innerText = `Rs. ${(val / 40).toFixed(2)} / kg`;
            });

            document.getElementById('print-date').innerText = new Date().toLocaleString();
        });

        // Theme Switcher Logic
        function changeTheme(themeName) {
            appState.theme = themeName;
            document.documentElement.setAttribute('data-theme', themeName);
            saveState();
        }

        // Automatic LocalStorage Save Protocol
        function saveState() {
            localStorage.setItem('rajpoot_traders_v2_state', JSON.stringify(appState));
            updateUI();
        }

        // Automatic LocalStorage Load Protocol
        function loadState() {
            const saved = localStorage.getItem('rajpoot_traders_v2_state');
            if (saved) {
                try {
                    appState = JSON.parse(saved);
                } catch(e) {
                    console.error("Error loading stored data", e);
                }
            } else {
                // Initialize default demo seed on first load
                appState.customers = [{
                    id: 'CUST-101',
                    name: 'Chaudhary Zubair',
                    phone: '0300-6677889',
                    city: 'Faisalabad',
                    createdAt: new Date().toISOString(),
                    transactions: [
                        {
                            id: 'TX-1000',
                            type: 'PREVIOUS_BALANCE',
                            timestamp: new Date(Date.now() - 86400000 * 5).toISOString(),
                            bundles: 0,
                            weightKg: 0,
                            rate40kg: 0,
                            debit: 15000,
                            credit: 0,
                            note: 'Previous Balance (Arrears brought forward)'
                        },
                        {
                            id: 'TX-1001',
                            type: 'SALE',
                            timestamp: new Date(Date.now() - 86400000 * 2).toISOString(),
                            bundles: 12,
                            weightKg: 480,
                            rate40kg: 1250,
                            debit: (480 * (1250 / 40)),
                            credit: 0,
                            note: 'Truck Loading'
                        }
                    ]
                }];
                appState.activeCustomerId = 'CUST-101';
            }

            // Apply theme from state
            const activeTheme = appState.theme || 'emerald';
            document.documentElement.setAttribute('data-theme', activeTheme);
            document.getElementById('theme-select').value = activeTheme;

            updateUI();
        }

        function updateDailyRate(e) {
            e.preventDefault();
            const rateVal = parseFloat(document.getElementById('daily-rate-input').value);
            if (rateVal >= 0) {
                appState.dailyRate40kg = rateVal;
                saveState();
                showNotification("Daily rate updated successfully!");
            }
        }

        function addCustomer(e) {
            e.preventDefault();
            const nameInput = document.getElementById('cust-name');
            const phoneInput = document.getElementById('cust-phone');
            const cityInput = document.getElementById('cust-city');
            const prevBalanceInput = document.getElementById('cust-prev-balance');

            const prevBalanceVal = parseFloat(prevBalanceInput.value) || 0;

            const newCust = {
                id: 'CUST-' + Math.floor(1000 + Math.random() * 9000),
                name: nameInput.value.trim(),
                phone: phoneInput.value.trim() || 'N/A',
                city: cityInput.value.trim() || 'N/A',
                createdAt: new Date().toISOString(),
                transactions: []
            };

            // If user inputted a previous balance, automatically record an initial arrears entry
            if (prevBalanceVal > 0) {
                newCust.transactions.push({
                    id: 'TX-' + Math.floor(100000 + Math.random() * 900000),
                    type: 'PREVIOUS_BALANCE',
                    timestamp: new Date().toISOString(),
                    bundles: 0,
                    weightKg: 0,
                    rate40kg: 0,
                    debit: prevBalanceVal,
                    credit: 0,
                    note: 'Previous Unpaid Balance (Arrears Brought Forward)'
                });
            }

            appState.customers.unshift(newCust);
            appState.activeCustomerId = newCust.id;

            nameInput.value = '';
            phoneInput.value = '';
            cityInput.value = '';
            prevBalanceInput.value = '';

            saveState();
            showNotification(`Customer ${newCust.name} added!`);
        }

        function deleteCustomer() {
            if (!appState.activeCustomerId) return;
            const cust = appState.customers.find(c => c.id === appState.activeCustomerId);
            if (!cust) return;

            if (confirm(`Are you sure you want to delete ${cust.name}?`)) {
                appState.customers = appState.customers.filter(c => c.id !== appState.activeCustomerId);
                appState.activeCustomerId = appState.customers.length > 0 ? appState.customers[0].id : null;
                saveState();
                showNotification("Customer profile deleted.");
            }
        }

        function selectCustomer(id) {
            appState.activeCustomerId = id;
            updateUI();
        }

        function openSaleModal() {
            if (!appState.activeCustomerId) return;
            document.getElementById('modal-sale-rate-display').innerText = `Rs. ${appState.dailyRate40kg} / 40kg`;
            document.getElementById('sale-form').reset();
            document.getElementById('sale-calculated-total').innerText = 'Rs. 0.00';
            document.getElementById('sale-modal').classList.remove('hidden');
        }

        function closeSaleModal() {
            document.getElementById('sale-modal').classList.add('hidden');
        }

        function calculateSaleTotal() {
            const weight = parseFloat(document.getElementById('sale-weight').value) || 0;
            const perKgRate = appState.dailyRate40kg / 40;
            const total = weight * perKgRate;
            document.getElementById('sale-calculated-total').innerText = `Rs. ${total.toLocaleString('en-PK', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
        }

        function submitSale(e) {
            e.preventDefault();
            const cust = appState.customers.find(c => c.id === appState.activeCustomerId);
            if (!cust) return;

            const bundles = parseInt(document.getElementById('sale-bundles').value) || 0;
            const weightKg = parseFloat(document.getElementById('sale-weight').value) || 0;
            const note = document.getElementById('sale-note').value.trim() || 'Tori Sale';
            
            const perKgRate = appState.dailyRate40kg / 40;
            const debitAmount = weightKg * perKgRate;

            const newTx = {
                id: 'TX-' + Math.floor(100000 + Math.random() * 900000),
                type: 'SALE',
                timestamp: new Date().toISOString(),
                bundles: bundles,
                weightKg: weightKg,
                rate40kg: appState.dailyRate40kg,
                debit: debitAmount,
                credit: 0,
                note: note
            };

            cust.transactions.push(newTx);
            saveState();
            closeSaleModal();
            showNotification(`Sale recorded for ${cust.name}`);
        }

        function openPaymentModal() {
            if (!appState.activeCustomerId) return;
            document.getElementById('payment-form').reset();
            document.getElementById('payment-modal').classList.remove('hidden');
        }

        function closePaymentModal() {
            document.getElementById('payment-modal').classList.add('hidden');
        }

        function submitPayment(e) {
            e.preventDefault();
            const cust = appState.customers.find(c => c.id === appState.activeCustomerId);
            if (!cust) return;

            const payAmount = parseFloat(document.getElementById('pay-amount').value) || 0;
            const method = document.getElementById('pay-method').value;
            const note = document.getElementById('pay-note').value.trim();
            const fullNote = `Payment (${method})${note ? ' - ' + note : ''}`;

            const newTx = {
                id: 'TX-' + Math.floor(100000 + Math.random() * 900000),
                type: 'PAYMENT',
                timestamp: new Date().toISOString(),
                bundles: 0,
                weightKg: 0,
                rate40kg: 0,
                debit: 0,
                credit: payAmount,
                note: fullNote
            };

            cust.transactions.push(newTx);
            saveState();
            closePaymentModal();
            showNotification(`Payment recorded!`);
        }

        // Open/Close Previous Payment / Arrears Modal
        function openPrevPaymentModal() {
            if (!appState.activeCustomerId) return;
            document.getElementById('prev-payment-form').reset();
            document.getElementById('prev-payment-modal').classList.remove('hidden');
        }

        function closePrevPaymentModal() {
            document.getElementById('prev-payment-modal').classList.add('hidden');
        }

        // Submit Previous Payment / Arrears Entry
        function submitPrevBalance(e) {
            e.preventDefault();
            const cust = appState.customers.find(c => c.id === appState.activeCustomerId);
            if (!cust) return;

            const prevAmount = parseFloat(document.getElementById('prev-amount').value) || 0;
            const note = document.getElementById('prev-note').value.trim() || 'Previous Unpaid Balance';

            const newTx = {
                id: 'TX-' + Math.floor(100000 + Math.random() * 900000),
                type: 'PREVIOUS_BALANCE',
                timestamp: new Date().toISOString(),
                bundles: 0,
                weightKg: 0,
                rate40kg: 0,
                debit: prevAmount,
                credit: 0,
                note: note
            };

            cust.transactions.push(newTx);
            saveState();
            closePrevPaymentModal();
            showNotification(`Previous balance added!`);
        }

        function deleteTransaction(txId) {
            const cust = appState.customers.find(c => c.id === appState.activeCustomerId);
            if (!cust) return;

            if (confirm("Remove this entry from ledger?")) {
                cust.transactions = cust.transactions.filter(t => t.id !== txId);
                saveState();
                showNotification("Entry deleted.");
            }
        }

        function updateUI() {
            const rate = appState.dailyRate40kg || 0;
            const perKg = (rate / 40).toFixed(2);
            document.getElementById('nav-daily-rate').innerText = `Rs. ${rate.toLocaleString()}`;
            document.getElementById('nav-kg-rate').innerText = `Rs. ${perKg}`;
            document.getElementById('daily-rate-input').value = rate;
            document.getElementById('calculated-per-kg').innerText = `Rs. ${perKg} / kg`;

            renderCustomerList();
            renderActivePortal();
            
            lucide.createIcons();
        }

        function renderCustomerList() {
            const listEl = document.getElementById('customer-list');
            const searchVal = (document.getElementById('search-customer')?.value || '').toLowerCase();
            
            document.getElementById('customer-count').innerText = appState.customers.length;

            const filtered = appState.customers.filter(c => 
                c.name.toLowerCase().includes(searchVal) || 
                c.phone.toLowerCase().includes(searchVal)
            );

            if (filtered.length === 0) {
                listEl.innerHTML = `<div class="text-center py-8 text-xs text-muted-custom">No customers found.</div>`;
                return;
            }

            listEl.innerHTML = filtered.map(c => {
                const totalBalance = calculateCustomerBalance(c);
                const isActive = c.id === appState.activeCustomerId;

                return `
                    <div onclick="selectCustomer('${c.id}')" class="p-3 rounded-xl border transition cursor-pointer flex justify-between items-center ${isActive ? 'bg-brand-50 border-brand-500 shadow-sm' : 'bg-card border-custom hover:border-slate-300'}">
                        <div>
                            <div class="font-bold text-xs flex items-center gap-1.5">
                                ${c.name}
                                ${isActive ? '<span class="w-1.5 h-1.5 rounded-full bg-brand-500"></span>' : ''}
                            </div>
                            <div class="text-[10px] text-muted-custom mt-0.5">${c.phone} • ${c.city}</div>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-bold ${totalBalance > 0 ? 'text-rose-600' : 'text-emerald-600'}">
                                Rs. ${totalBalance.toLocaleString('en-PK')}
                            </span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function calculateCustomerBalance(customer) {
            if (!customer || !customer.transactions) return 0;
            return customer.transactions.reduce((acc, tx) => acc + (tx.debit || 0) - (tx.credit || 0), 0);
        }

        function renderActivePortal() {
            const activeEl = document.getElementById('active-portal');
            const emptyEl = document.getElementById('no-portal-selected');

            const cust = appState.customers.find(c => c.id === appState.activeCustomerId);

            if (!cust) {
                activeEl.classList.add('hidden');
                emptyEl.classList.remove('hidden');
                return;
            }

            activeEl.classList.remove('hidden');
            emptyEl.classList.add('hidden');

            document.getElementById('portal-cust-id').innerText = cust.id;
            document.getElementById('portal-cust-name').innerText = cust.name;
            document.getElementById('portal-cust-phone').innerText = cust.phone;
            document.getElementById('portal-cust-city').innerText = cust.city;

            document.getElementById('print-cust-name').innerText = cust.name;
            document.getElementById('print-cust-phone').innerText = cust.phone;

            const totalBalance = calculateCustomerBalance(cust);
            const balanceFormatted = `Rs. ${totalBalance.toLocaleString('en-PK', {minimumFractionDigits:2, maximumFractionDigits:2})}`;
            
            document.getElementById('portal-cust-balance').innerText = balanceFormatted;
            document.getElementById('print-cust-balance').innerText = balanceFormatted;

            const tbody = document.getElementById('ledger-body');
            const emptyMsg = document.getElementById('empty-ledger-msg');

            if (!cust.transactions || cust.transactions.length === 0) {
                tbody.innerHTML = '';
                emptyMsg.classList.remove('hidden');
                return;
            }

            emptyMsg.classList.add('hidden');

            const sortedTx = [...cust.transactions].sort((a,b) => new Date(a.timestamp) - new Date(b.timestamp));

            let runningBalance = 0;

            tbody.innerHTML = sortedTx.map(tx => {
                runningBalance += (tx.debit || 0) - (tx.credit || 0);
                const isSale = tx.type === 'SALE';
                const isPrev = tx.type === 'PREVIOUS_BALANCE';
                const dt = new Date(tx.timestamp);
                const dateStr = dt.toLocaleDateString() + ' ' + dt.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});

                let typeLabel = 'Payment Received';
                if (isSale) typeLabel = 'Tori Sale';
                if (isPrev) typeLabel = 'Previous Balance';

                return `
                    <tr class="hover:bg-slate-50/50 transition">
                        <td class="py-2.5 px-3 text-[11px] text-muted-custom whitespace-nowrap">${dateStr}</td>
                        <td class="py-2.5 px-3">
                            <div class="font-semibold text-xs flex items-center gap-1.5">
                                ${typeLabel}
                                ${isPrev ? '<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-100 text-amber-800 border border-amber-300">Arrears</span>' : ''}
                            </div>
                            <div class="text-[10px] text-muted-custom">${tx.note || '-'}</div>
                        </td>
                        <td class="py-2.5 px-3 text-center font-medium">${isSale ? tx.bundles + ' bdls' : '-'}</td>
                        <td class="py-2.5 px-3 text-right font-medium">${isSale ? tx.weightKg.toLocaleString() + ' kg' : '-'}</td>
                        <td class="py-2.5 px-3 text-right text-[11px] text-muted-custom">${isSale ? 'Rs. ' + tx.rate40kg : '-'}</td>
                        <td class="py-2.5 px-3 text-right font-bold text-rose-600">${tx.debit > 0 ? 'Rs. ' + tx.debit.toLocaleString('en-PK', {minimumFractionDigits:2}) : '-'}</td>
                        <td class="py-2.5 px-3 text-right font-bold text-sky-600">${tx.credit > 0 ? 'Rs. ' + tx.credit.toLocaleString('en-PK', {minimumFractionDigits:2}) : '-'}</td>
                        <td class="py-2.5 px-3 text-right font-black">Rs. ${runningBalance.toLocaleString('en-PK', {minimumFractionDigits:2})}</td>
                        <td class="py-2.5 px-3 text-center no-print">
                            <button onclick="deleteTransaction('${tx.id}')" title="Delete Entry" class="text-slate-400 hover:text-rose-600 transition">
                                <i data-lucide="trash" class="w-3.5 h-3.5 inline"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).reverse().join('');
        }

        function showNotification(msg) {
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-5 right-5 bg-slate-900 text-white text-xs px-4 py-3 rounded-full shadow-2xl z-50 flex items-center gap-2 border border-slate-700';
            toast.innerHTML = `<i data-lucide="info" class="w-4 h-4 text-brand-500"></i> ${msg}`;
            document.body.appendChild(toast);
            lucide.createIcons();
            setTimeout(() => toast.remove(), 3000);
        }

        function clearAllData() {
            if (confirm("Reset all stored data? This cannot be undone.")) {
                localStorage.removeItem('rajpoot_traders_v2_state');
                location.reload();
            }
        }
    </script>
</body>
</html>
